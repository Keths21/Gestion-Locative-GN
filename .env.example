# Modèle de configuration — copier en .env.local et renseigner.
# Ce fichier ne contient AUCUNE valeur réelle : il ne sert qu'à lister ce qui
# est attendu. Voir le README pour le détail de chaque variable.

# --- Figées à la construction ------------------------------------------------
# Next remplace ces valeurs dans le bundle au moment du build : elles sont
# gravées dans l'image Docker.
#
# Cartographie. Sans clé Esri, l'application bascule seule sur OpenStreetMap ;
# les trois variables de tuiles ne servent qu'à imposer d'autres fonds.
NEXT_PUBLIC_ARCGIS_API_KEY=
# NEXT_PUBLIC_TUILES_PLAN=
# NEXT_PUBLIC_TUILES_SATELLITE=
# NEXT_PUBLIC_TUILES_REPERES=

# --- Lues au démarrage --------------------------------------------------------
# Projet Supabase. Volontairement SANS préfixe NEXT_PUBLIC_ : figées dans le
# bundle, elles marieraient l'image à une seule base et interdiraient de
# promouvoir en production l'image validée en recette. Le layout racine les
# transmet au navigateur au rendu. La clé anon reste publique par nature —
# c'est le RLS qui protège les données.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Administration des comptes. Secret : ne doit jamais atteindre le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique de l'environnement, pour les liens des courriels.
# Volontairement sans préfixe NEXT_PUBLIC_ : lue au démarrage, elle permet à une
# même image de servir la recette et la production.
APP_URL=http://localhost:3000

# Courriel
RESEND_API_KEY=

# SMS : nimbasms (défaut) ou africastalking
SMS_PROVIDER=nimbasms
NIMBASMS_AUTH_TOKEN=
NIMBASMS_SENDER_NAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_SENDER_ID=
# AFRICASTALKING_SANDBOX=

# WhatsApp — Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
